# Copy to .env and fill in the secrets. Never commit .env.
# cp .env.example .env

# --- PostgreSQL ---
POSTGRES_USER=cmm
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cmm_quality
DB_PORT=5432
# Used when running the backend outside Docker (tests, local uv run). Inside Compose it is overridden.
DATABASE_URL=postgresql+psycopg://cmm:change-me@localhost:5432/cmm_quality

# --- API / auth ---
API_PORT=8000
# Long random string, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_HOURS=12
# Origin of the web app, used for CORS and links in alert emails
WEB_ORIGIN=http://localhost:5173
APP_BASE_URL=http://localhost:5173
LOG_LEVEL=INFO
# Where uploads, inbox, processed and failed folders live (gitignored)
DATA_DIR=./data

# --- Demo mode ---
DEMO_MODE=true
# Password for all seeded demo users (inspector, owner.vmc02, owner.hmc01, supervisor, qhead, admin, viewer)
DEMO_USER_PASSWORD=change-me-demo
# demo = 60 s / 120 s escalation timers; plant = per-classification timers (Section 10.4)
ESCALATION_PROFILE=demo

# --- Email (Mailpit in demo) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=cmm-alerts@demo.local
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Web ---
WEB_DEV_PORT=5173
WEB_PROD_PORT=8080

# --- Optional AI (Section 19). Everything works with AI_ENABLED=false and no key. ---
# Used only for PDF reports the deterministic table reader cannot parse. Provider: Groq.
AI_ENABLED=false
AI_PROVIDER=groq
# Groq API key (gsk_...). Never commit it; keep it only in .env.
AI_API_KEY=
# Any JSON-capable model listed in your Groq console.
AI_MODEL=llama-3.3-70b-versatile
